{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "chrome",
      "node"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.js",
    "build.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}